<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<Pane fx:id="arenaPane" prefHeight="900.0" prefWidth="1800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Rectangle fx:id="topblack" arcHeight="5.0" arcWidth="5.0" height="70.0" layoutX="-11.0" stroke="BLACK" strokeType="INSIDE" width="1823.0" />
      <Rectangle fx:id="arena" arcHeight="5.0" arcWidth="5.0" fill="#00ffe733" height="624.0" layoutX="100.0" layoutY="150.0" stroke="BLACK" strokeType="INSIDE" width="1600.0" />
      <Circle fx:id="player" fill="#1fff29" layoutX="205.0" layoutY="281.0" radius="40.0" stroke="BLACK" strokeType="INSIDE" />
      <Circle fx:id="enemy" fill="#ff1f1f" layoutX="665.0" layoutY="321.0" radius="29.0" stroke="BLACK" strokeType="INSIDE" />
      <Button fx:id="btnButton" layoutX="361.0" layoutY="177.0" mnemonicParsing="false" text="start" />
      <Button fx:id="btnEnemy" layoutX="1469.0" layoutY="831.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="142.0" text="enemy spawn" />
      <StackPane fx:id="crosshair" layoutX="907.0" layoutY="445.0" prefHeight="51.0" prefWidth="30.0">
         <children>
            <Line endY="50.0" />
            <Line endX="50.0" />
         </children>
      </StackPane>
   </children>
</Pane>
